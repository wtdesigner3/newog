# ==============================================================================
# OG Heavy Duty — Environment Configuration Template (.env.example)
# Modern Next.js 16 (App Router) + MongoDB Atlas + Cloudinary + Resend
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Application Public URLs & Branding
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="OG Heavy Duty"
NEXT_PUBLIC_BRAND_PRIMARY="#0f7ae0"
NEXT_PUBLIC_BRAND_ACCENT="#f94d1c"

# MongoDB Database Connection
# Standard MongoDB Connection String (Atlas SRV or standalone)
MONGODB_URI=mongodb://localhost:27017/ogheavyduty_dev
# Legacy alias fallback
MONGO_URI=mongodb://localhost:27017/ogheavyduty_dev

# JWT Authentication
# Generated secure random string (minimum 32 characters)
JWT_SECRET=super_secret_og_heavyduty_jwt_key_at_least_32_chars_long_2026
JWT_EXPIRES_IN=1d

# Cloudinary Storage Configuration
USE_CLOUD_STORAGE=false
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_ROOT_FOLDER=ogheavyduty

# Resend Transactional Email
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=OG Heavy Duty <noreply@ogheavyduty.in>
NOTIFICATION_EMAIL=admin@ogheavyduty.in

# Google reCAPTCHA v3 (For public enquiry / contact forms)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

